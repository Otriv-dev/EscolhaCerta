# Copie para .env e use senhas próprias. Os scripts init geram senhas aleatórias.
DB_USER=escolhacerta
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PORT=3307
APP_PORT=8080
ADMIN_EMAIL=admin@escolhacerta.local
ADMIN_PASSWORD=
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3307/escolhacerta?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
STORAGE_TYPE=local
UPLOAD_DIR=./uploads/
# Produção: banco gerenciado com TLS e armazenamento externo.
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:mysql://SEU_HOST:3306/escolhacerta?sslMode=VERIFY_IDENTITY&serverTimezone=UTC
# STORAGE_TYPE=s3
# S3_BUCKET=
# AWS_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://SEU_CDN_OU_BUCKET
# S3_ENDPOINT= (opcional para storage compatível S3)
# Prefira IAM/workload identity. Fora da AWS, AWS_ACCESS_KEY_ID e AWS_SECRET_ACCESS_KEY.

# Fuso para exibição de datas; armazenamento permanece UTC.
DISPLAY_TIME_ZONE=America/Sao_Paulo
